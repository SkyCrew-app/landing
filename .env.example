# Copy to .env.local (development) or set in the host's environment (production).
# Never commit a filled-in copy. Only NEXT_PUBLIC_* values reach the browser, and they are
# read when the site is BUILT: rebuild after changing one.

# --- Public addresses (build time) ---------------------------------------------------------
# Address of this site, without trailing slash (canonical links, sitemap, Stripe return URLs).
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Address of the SkyCrew application. Empty = the "Se connecter" link is hidden.
NEXT_PUBLIC_APP_URL=
# Stripe customer portal login link (Stripe › Settings › Billing › Customer portal).
# Empty = the "Gérer mon abonnement" link is hidden.
NEXT_PUBLIC_STRIPE_PORTAL_LOGIN_URL=

# --- Stripe (server only, read at run time) --------------------------------------------------
# Online subscription is offered only when BOTH are set; otherwise /commencer shows the
# "Demander la mise en place" request form.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# VAT: either let Stripe Tax compute it (must be activated in Stripe)...
STRIPE_AUTOMATIC_TAX=false
# ...or apply one fixed tax rate created in Stripe (e.g. TVA 20 %, exclusive). Leave both
# empty only if no VAT is due (franchise en base).
STRIPE_TAX_RATE_ID=
# Optional: Stripe Price ids. Without them, prices come from src/config/offer.ts. Each price
# must be recurring with the matching interval (month or year) and stay equal to the config.
STRIPE_PRICE_CLUB_MONTHLY_FLAT=
STRIPE_PRICE_CLUB_MONTHLY_AIRCRAFT=
STRIPE_PRICE_CLUB_YEARLY_FLAT=
STRIPE_PRICE_CLUB_YEARLY_AIRCRAFT=
STRIPE_PRICE_CLUB_ECOLE_MONTHLY_FLAT=
STRIPE_PRICE_CLUB_ECOLE_MONTHLY_AIRCRAFT=
STRIPE_PRICE_CLUB_ECOLE_YEARLY_FLAT=
STRIPE_PRICE_CLUB_ECOLE_YEARLY_AIRCRAFT=

# --- Owner notifications (server only) ------------------------------------------------------
# Contact form, set-up requests, new subscriptions, cancellations, failed payments.
# At least one channel is required, or the forms answer that sending is not configured.
# Webhook receiving JSON {"content": "..."} (a Discord channel webhook works as is).
OWNER_NOTIFY_WEBHOOK_URL=
# E-mail, used when SMTP_HOST and OWNER_NOTIFY_EMAIL are both set.
OWNER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
